# Clave de Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

MODELO=gemini-3.5-flash-lite

# Token del bot (lo da BotFather; vacío hasta el paso 5)
TELEGRAM_TOKEN=

# Secreto que Telegram manda en cada webhook para que la API lo verifique
TELEGRAM_SECRET=cambiame

# URL https pública del servicio (Heroku o un túnel de cloudflared)
PUBLIC_URL=
